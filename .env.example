# ===== Front-end (Vite) — vai embutido no app =====
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY
# Trava extra (recomendado): mesmo valor do secret AURA_ACCESS_TOKEN abaixo. Gere com: openssl rand -hex 24
VITE_AURA_ACCESS_TOKEN=

# ===== Secrets das Edge Functions (NÃO ficam neste arquivo) =====
# Configure com: supabase secrets set NOME=valor ...
#   GEMINI_API_KEY             chave do Google AI Studio
#   VAULT_MASTER_KEY           openssl rand -hex 32   (perder esta chave = perder as senhas do Cofre)
#   AURA_ACCESS_TOKEN          mesmo valor de VITE_AURA_ACCESS_TOKEN
#   BROWSER_USE_API_KEY        bu_...
#   BROWSER_USE_DEFAULT_PROFILE_ID  UUID do perfil persistente (opcional)
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN   (Gmail + Agenda, somente leitura)
#   GEMINI_MODEL / GEMINI_EMBED_MODEL / GEMINI_LIVE_MODEL            (opcionais: sobrescrevem os modelos padrão)
